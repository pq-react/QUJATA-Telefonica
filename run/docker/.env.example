# Copy to .env (never commit .env) and fill in.
# Used by docker-compose.pqreact.yml (PQ-REACT Katana/5G testbed stack).

# --- Local QUJATA MySQL (also used by the Grafana qujata-mysql datasource)
MYSQL_ROOT_PASSWORD=<change-me>

# --- Grafana admin
GRAFANA_ADMIN_USER=qujata
GRAFANA_ADMIN_PASSWORD=<change-me>

# --- Portal: URLs as seen from the user's browser (public host of this VM)
PORTAL_API_URL=http://<qujata-host>:3020/qujata-api
PORTAL_DASHBOARD_URL=http://<qujata-host>:3000

# --- Katana/5G slicing testbed adapters
# SecGW1 node: secgw adapter (:30666), iperf-runner (:30667), iperf metrics (:30100)
SECGW1_URL=http://<secgw1-host>:30666
SECGW2_URL=http://<secgw2-host>:30666
IPERF_URL=http://<secgw1-host>:30667
IPERF_METRICS_URL=http://<secgw1-host>:30100
# Katana slice manager NBI and KPI exporter
KATANA_NBI_URL=http://<katana-host>:8000
KATANA_KPI_URL=http://<katana-kpi-host>:8080

# --- Phase A: live push into the MCP MariaDB (leave MCP_DB_HOST empty to disable)
MCP_DB_HOST=pqreact-mcp-mariadb
MCP_DB_PORT=3306
MCP_DB_NAME=PQREACT
MCP_DB_USER=pqreact
MCP_DB_PASSWORD=<change-me>

# --- Optional: CAM InfluxDB token for the PM_metrics dashboard (cam-influxdb datasource)
CAM_INFLUXDB_TOKEN=<change-me>
